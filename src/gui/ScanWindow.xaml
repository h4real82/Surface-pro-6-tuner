<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surface Pro 6 - System Health &amp; Optimierungs-Scanner"
        Height="720" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#18181b"
        Foreground="#f4f4f5"
        FontFamily="Segoe UI, Segoe UI Variable"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#38bdf8"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0284c7"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#16a34a"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Score / Summary Bar -->
            <RowDefinition Height="*"/>    <!-- Scrollable Audit Results -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons Footer -->
        </Grid.RowDefinitions>

        <!-- TOP SUMMARY / SCORE CARD -->
        <Border Grid.Row="0" Background="#27272a" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#3f3f46" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="System-Optimierungs-Audit" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock x:Name="TxtScanSummary" Text="Analyse laeuft..." FontSize="13" Foreground="#a1a1aa" Margin="0,4,0,8"/>
                    <ProgressBar x:Name="PrgScanScore" Height="10" Value="0" Maximum="100" Background="#3f3f46" Foreground="#22c55e" Margin="0,0,20,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="BtnRescan" Content="Erneut scannen" Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- AUDIT LIST -->
        <Border Grid.Row="1" Background="#202023" CornerRadius="10" Padding="10" BorderBrush="#27272a" BorderThickness="1">
            <ListBox x:Name="LstAuditItems" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- FOOTER ACTIONS -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtScanPendingNotice" Grid.Column="0" Text="" FontSize="12" Foreground="#facc15" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="BtnApplyAllRecommendations" Content="Alle Empfehlungen anwenden" Style="{StaticResource SuccessButton}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" x:Name="BtnCloseScan" Content="Schliessen" Style="{StaticResource ActionButton}" Background="#3f3f46"/>
        </Grid>
    </Grid>
</Window>
