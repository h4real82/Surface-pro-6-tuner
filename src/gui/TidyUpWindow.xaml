<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surface Pro 6 - Tidy Up &amp; Cleaner"
        Height="760" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#18181b"
        Foreground="#f4f4f5"
        FontFamily="Segoe UI, Segoe UI Variable"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0284c7"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#dc2626"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#16a34a"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="140"/>  <!-- Live Log Output -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#27272a" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#3f3f46" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Surface Pro 6 Tidy Up &amp; Deep Cleaner" FontSize="18" FontWeight="Bold" Foreground="#38bdf8"/>
                    <TextBlock Text="Entfernt vorinstallierte Apps rueckstandslos und bereinigt System- &amp; Cache-Daten nach Sicherheitsstufen." FontSize="12" Foreground="#a1a1aa" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnCloseTidyUp" Content="Schliessen" Style="{StaticResource ActionButton}" Background="#3f3f46" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
            <!-- TAB 1: APP REMOVAL -->
            <TabItem Header="Windows Apps deinstallieren (Bloatware)">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#202023" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waehle vorinstallierte Apps zur sauberen Deinstallation (fuer alle Benutzer &amp; Provisioning):" FontSize="12" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BtnSelectSafeApps" Content="Empfohlene Bloatware markieren" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" x:Name="BtnDeselectAllApps" Content="Alle abwaehlen" Style="{StaticResource ActionButton}" Background="#3f3f46"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#202023" CornerRadius="8" Padding="6" BorderBrush="#27272a" BorderThickness="1">
                        <ListBox x:Name="LstApps" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="BtnUninstallSelectedApps" Content="Ausgewaehlte Apps restlos entfernen" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: DISK & CACHE CLEANUP -->
            <TabItem Header="Speicher- &amp; Cache-Bereinigung">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Security Concept Levels -->
                        <RowDefinition Height="*"/>    <!-- Category Size Breakdown -->
                        <RowDefinition Height="Auto"/> <!-- Action Bar -->
                    </Grid.RowDefinitions>

                    <!-- SAFETY CONCEPT SELECTION -->
                    <Border Grid.Row="0" Background="#202023" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#3f3f46" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Sicherheitskonzeptstufen fuer Dateisystem-Bereinigung:" FontSize="13" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RadLevel1" GroupName="SafetyLevel" IsChecked="True" Foreground="#4ade80" Margin="0,0,0,4">
                                <TextBlock Text="Stufe 1 (Sicher / Basis): Benutzer-Temp, System-Temp, Fehlerberichte, Miniaturansichten, Browser-Caches (0% Risiko)" FontSize="12"/>
                            </RadioButton>
                            <RadioButton x:Name="RadLevel2" GroupName="SafetyLevel" Foreground="#facc15" Margin="0,0,0,4">
                                <TextBlock Text="Stufe 2 (Erweitert / Standard): Inklusive Windows Update Download-Cache, Delivery-Optimization, DirectX Shader Cache &amp; Prefetch" FontSize="12"/>
                            </RadioButton>
                            <RadioButton x:Name="RadLevel3" GroupName="SafetyLevel" Foreground="#f87171">
                                <TextBlock Text="Stufe 3 (Tiefenreinigung / Aggressiv): Inklusive DISM Component-Store Bereinigung und alter Windows-Installationen (Windows.old)" FontSize="12"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- CATEGORIES BREAKDOWN -->
                    <Border Grid.Row="1" Background="#202023" CornerRadius="8" Padding="8" BorderBrush="#27272a" BorderThickness="1">
                        <ListBox x:Name="LstDiskCategories" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- ACTION FOOTER -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtDiskTotal" Grid.Column="0" Text="Noch nicht analysiert" FontSize="13" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BtnAnalyzeDisk" Content="Speicherplatz analysieren" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" x:Name="BtnExecuteClean" Content="Bereinigung starten" Style="{StaticResource SuccessButton}"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- LIVE LOG OUTPUT -->
        <Border Grid.Row="2" Background="#18181b" CornerRadius="8" Padding="8" BorderBrush="#27272a" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Tidy Up Aktivitaets-Protokoll:" FontSize="11" FontWeight="SemiBold" Foreground="#71717a" Margin="2,0,0,4"/>
                <TextBox Grid.Row="1" x:Name="TxtTidyLog" Background="#09090b" Foreground="#22c55e" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="0" Padding="6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
