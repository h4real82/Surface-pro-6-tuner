<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft Surface Pro 6 Tuner"
        Height="780" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#18181b"
        Foreground="#f4f4f5"
        FontFamily="Segoe UI, Segoe UI Variable"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0284c7"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#16a34a"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Danger / Fallback Button Style -->
        <Style x:Key="FallbackBtn" TargetType="Button">
            <Setter Property="Background" Value="#dc2626"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Device Info -->
            <RowDefinition Height="Auto"/> <!-- Action Cards Grid -->
            <RowDefinition Height="Auto"/> <!-- Fallback / Rollback Section -->
            <RowDefinition Height="*"/>    <!-- Activity Log Output -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#27272a" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="#3f3f46" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Surface Pro 6 Tuner" FontSize="22" FontWeight="Bold" Foreground="#38bdf8"/>
                        <Border Background="#0369a1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0 Safety Edition" FontSize="11" FontWeight="SemiBold" Foreground="#ffffff"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtDeviceInfo" Text="Erkenne Hardware..." FontSize="13" Foreground="#a1a1aa" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="BadgeThermal" Background="#14532d" CornerRadius="8" Padding="12,6" BorderBrush="#22c55e" BorderThickness="1">
                        <TextBlock x:Name="TxtThermalStatus" Text="Thermal Status: Normal" FontSize="12" FontWeight="SemiBold" Foreground="#4ade80"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4 MAIN ACTION CARDS (2x2) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Performance -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🚀 Performance Optimizer" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                    <TextBlock Grid.Row="1" Text="Deaktiviert Windows-Telemetrie, GameDVR Hintergrundaufzeichnung und Cortana/Bing-Suche. Entlastet CPU &amp; Intel UHD 620 GPU spürbar." TextWrapping="Wrap" FontSize="12" Foreground="#a1a1aa" Margin="0,6,0,12"/>
                    <Button Grid.Row="2" x:Name="BtnApplyPerformance" Content="Performance anwenden" Style="{StaticResource PrimaryBtn}"/>
                </Grid>
            </Border>

            <!-- Card 2: Battery & Standby -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🔋 Akku &amp; Modern Standby" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                    <TextBlock Grid.Row="1" Text="Optimiert Connected Standby (schaltet Wake-Timer im Ruhezustand ab) und drosselt ungenutzte Hintergrund-UWP-Apps für maximale Laufzeit." TextWrapping="Wrap" FontSize="12" Foreground="#a1a1aa" Margin="0,6,0,12"/>
                    <Button Grid.Row="2" x:Name="BtnApplyBattery" Content="Akku anwenden" Style="{StaticResource PrimaryBtn}"/>
                </Grid>
            </Border>

            <!-- Card 3: Thermal Unlock -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="⚡ Thermal Unthrottle" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                    <TextBlock Grid.Row="1" Text="Konfiguriert das Power-Overlay für maximale CPU-Stabilität und wirkt dem berüchtigten 400-MHz-BD-PROCHOT-Lock des Surface Pro 6 entgegen." TextWrapping="Wrap" FontSize="12" Foreground="#a1a1aa" Margin="0,6,0,12"/>
                    <Button Grid.Row="2" x:Name="BtnApplyThermal" Content="Thermal unthrotteln" Style="{StaticResource PrimaryBtn}"/>
                </Grid>
            </Border>

            <!-- Card 4: All-in-One Tuning -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="✨ Komplett-Tuning (All-in-One)" FontSize="15" FontWeight="Bold" Foreground="#4ade80"/>
                    <TextBlock Grid.Row="1" Text="Wendet alle sicheren Profile (Performance + Akku + Thermal) in einem Durchgang an. Erstellt für jeden Tweak automatisch ein Restore-Snapshot." TextWrapping="Wrap" FontSize="12" Foreground="#a1a1aa" Margin="0,6,0,12"/>
                    <Button Grid.Row="2" x:Name="BtnApplyAll" Content="Alles optimieren" Style="{StaticResource SuccessBtn}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- FALLBACK / ROLLBACK SECTION -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="6,2,6,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                    <TextBlock Text="🛡️ Fallback-Funktion (Aktionen rückgängig machen)" FontSize="15" FontWeight="Bold" Foreground="#f87171"/>
                    <TextBlock Text="Stellt den vorherigen Originalzustand der Registry vor den Optimierungen 1:1 wieder her." FontSize="12" Foreground="#a1a1aa" Margin="0,3,0,8"/>
                </StackPanel>

                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CmbSnapshots" Height="34" Margin="0,0,10,0" Background="#18181b" Foreground="#f4f4f5" VerticalContentAlignment="Center" Padding="8,4"/>
                <Button Grid.Row="1" Grid.Column="1" x:Name="BtnRollbackSelected" Content="Ausgewählten Snapshot rückgängig machen" Style="{StaticResource FallbackBtn}" Margin="0,0,8,0"/>
                <Button Grid.Row="1" Grid.Column="2" x:Name="BtnRollbackLatest" Content="Letzte Aktion rückgängig machen" Style="{StaticResource FallbackBtn}"/>
            </Grid>
        </Border>

        <!-- LOG & ACTIVITY STATUS -->
        <Border Grid.Row="3" Background="#18181b" CornerRadius="10" Padding="10" Margin="6,0,6,0" BorderBrush="#27272a" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Live-Aktivitätslog:" FontSize="11" FontWeight="SemiBold" Foreground="#71717a" Margin="2,0,0,6"/>
                <TextBox Grid.Row="1" x:Name="TxtLog" Background="#09090b" Foreground="#22c55e" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="0" Padding="8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
